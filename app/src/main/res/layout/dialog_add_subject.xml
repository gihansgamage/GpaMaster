<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Subject Name Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Subject Name"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

    <!-- Subject Name Input -->
    <EditText
        android:id="@+id/et_subject_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g., Mathematics"
        android:inputType="text"
        android:maxLines="1"
        android:padding="12dp"
        android:background="@drawable/field_bg"
        android:layout_marginBottom="16dp" />

    <!-- Credits Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Credits"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

    <!-- Credits Input -->
    <EditText
        android:id="@+id/et_credits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g., 3 or 3.5"
        android:inputType="numberDecimal"
        android:maxLines="1"
        android:padding="12dp"
        android:background="@drawable/field_bg"
        android:layout_marginBottom="16dp" />

    <!-- Grade Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grade"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

    <!-- Grade Spinner -->
    <Spinner
        android:id="@+id/spinner_grade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:padding="12dp"
        android:background="@drawable/field_bg"
        android:layout_marginBottom="16dp" />

    <!-- Percentage Label -->
    <TextView
        android:id="@+id/tv_percentage_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Percentage (Optional)"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- Percentage Input -->
    <EditText
        android:id="@+id/et_percentage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g., 85"
        android:inputType="numberDecimal"
        android:maxLines="1"
        android:padding="12dp"
        android:background="@drawable/field_bg"
        android:visibility="gone" />

    <!-- Hidden container for TextInputLayout compatibility -->
    <LinearLayout
        android:id="@+id/til_subject_name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/til_credits"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/til_percentage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>